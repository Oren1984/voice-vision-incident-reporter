  <section id="research" class="section section-alt">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Research</span>
        <h2 class="section-title">Sources</h2>
      </div>
      <div class="projects-grid refs">
        <a class="project-card reveal" href="https://arxiv.org/abs/2507.05165"><span class="project-category category-agent">Primary paper</span><span class="card-title">Differential Attention for Multimodal Crisis Event Analysis</span><span class="card-purpose">Munia, Zhu, Nasraoui, Imran · CVPR 2025 Workshops (MMFM3) · arXiv:2507.05165</span></a>
